[Unit]
Description=LAYA AI Core Background Service (STT, TTS, Conversational Agent)
Documentation=https://github.com/Yokesh2901/laya-os
After=laya-system.service pipewire.service graphical-session.target
Wants=laya-system.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/opt/laya-os
Environment=PYTHONPATH=/opt/laya-os
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/laya/.env
ExecStart=/opt/laya-os/.venv/bin/python3 -m laya.main
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
