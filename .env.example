# LAYA OS Configuration
# Copy this file to '.env' to override defaults.
# Never commit the actual '.env' file containing real secrets.

# --- LAYA AI CORE ---
# Primary Speech-to-Text Engine: 'local' (whisper/vosk) or 'sarvam'
LAYA_STT_ENGINE=local
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANG=ta-IN
SARVAM_STT_MODE=codemix

# Primary Text-to-Speech Engine: 'local' (piper/espeak), 'sarvam', or 'edge'
LAYA_TTS_ENGINE=local
SARVAM_TTS_SPEAKER=aarti_hi_customer
SARVAM_TTS_PACE=1.15
EDGE_TTS_VOICE_TAMIL=ta-IN-PallaviNeural
EDGE_TTS_VOICE_ENGLISH=en-IN-NeerjaNeural

# Primary LLM Provider: 'ollama' (default local), 'llamacpp', or 'cloud'
LAYA_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:latest

# Wake-word Detection: 'local' (openwakeword/pocketsphinx)
LAYA_WAKEWORD_ENGINE=local
LAYA_WAKEWORD=hey laya

# --- LAYA SYSTEM INTEGRATION ---
LAYA_DBUS_NAME=org.laya.SystemCore
LAYA_DBUS_PATH=/org/laya/SystemCore
LAYA_LOG_LEVEL=INFO
LAYA_REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true
